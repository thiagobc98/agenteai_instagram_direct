# ============================================================
# Instagram Direct LangChain — Variáveis de Ambiente
# ============================================================
# Copie este arquivo para .env e configure os valores.
# cp .env.example .env
#
# Tudo via OpenRouter — uma única API key para LLM, embeddings
# e transcrição de áudio.
#
# Ordem recomendada de preenchimento:
# 1) OPENROUTER_API_KEY
# 2) INSTAGRAM_APP_SECRET
# 3) INSTAGRAM_VERIFY_TOKEN
# 4) INSTAGRAM_ACCESS_TOKEN
# 5) INSTAGRAM_BUSINESS_ACCOUNT_ID (opcional)

# === Database ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_langchain

# === Server ===
PORT=8000
LOG_LEVEL=info
# true em produção para logs JSON estruturados
LOG_JSON=false

# === LLM (OpenRouter) ===
# Uma única API key para tudo: chat, embeddings, transcrição de áudio
OPENROUTER_API_KEY=sk-or-v1-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=x-ai/grok-4.3
OPENROUTER_MIDIA_MODEL=google/gemini-2.5-flash-lite

# === Instagram Direct (Instagram Messaging API) ===
# Veja docs/INSTAGRAM_API.md para o passo a passo completo.
# 1) App Secret do app Meta. Valida a assinatura X-Hub-Signature-256 de cada
# webhook (obrigatório na API). Com Instagram Login o painel tem DUAS chaves
# secretas: a do app Meta (Configurações do app -> Básico) e a "do app do
# Instagram" (Instagram -> Configuração da API). Se não souber qual assina o
# webhook, informe as duas separadas por vírgula: SEGREDO_A,SEGREDO_B
INSTAGRAM_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 2) Token PRÓPRIO (você inventa) informado no painel da Meta ao cadastrar
# o webhook; a Meta o devolve no GET de verificação. Gere com:
# python -c "import secrets;print(secrets.token_hex(24))"
# Callback URL no painel: https://SEU-DOMINIO/webhook/instagram?agent=secretaria
INSTAGRAM_VERIFY_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 3) Token de acesso da conta profissional, usado para enviar as respostas
# (obrigatório no Worker). Use o de longa duração e renove antes de expirar.
INSTAGRAM_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 4) ID da conta profissional (opcional): descarta eventos da própria conta.
INSTAGRAM_BUSINESS_ACCOUNT_ID=
# 5) Versão e host da Graph API. Padrão: Instagram Login (graph.instagram.com).
# Para Facebook Login use https://graph.facebook.com e o Page Access Token.
INSTAGRAM_GRAPH_API_VERSION=v25.0
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com

# === Rate Limit ===
# Máximo de mensagens por contato (IGSID) por hora
RATE_LIMIT_PER_HOUR=30

# === Redis ===
# Usado pelo rate limit distribuído (compartilhado entre réplicas da API)
REDIS_URL=redis://localhost:6379/0

# === Frontend / Admin Auth ===
# Origem do admin panel (Next.js) — usada pelo CORS. Em produção, aponte
# para o domínio público servido pelo proxy (mesma origem do frontend).
FRONTEND_ORIGIN=http://localhost:3000
ADMIN_USERNAME=admin
# Defina uma senha forte — sem isso, login fica sempre bloqueado
ADMIN_PASSWORD=
# Gere com: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET_KEY=dev-insecure-secret-change-me
SESSION_MAX_AGE_SECONDS=28800
# true em produção (cookie só trafega via HTTPS)
SESSION_COOKIE_SECURE=false

# === Deploy (docker-compose.prod.yml + Caddy) ===
# Domínio público (DNS A record apontando para a VPS) — usado pelo proxy
# reverso para emitir o certificado TLS automaticamente.
DOMAIN=admin.seudominio.com
# E-mail para avisos do Let's Encrypt (opcional)
ACME_EMAIL=

# === Debounce ===
# Segundos para agrupar mensagens rápidas do mesmo remetente
MESSAGE_BUFFER_SECONDS=2.0

# === LLM Rate Limit ===
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=0.5
LLM_RATE_LIMIT_MAX_BURST=10

# === Worker ===
POLL_INTERVAL_SECONDS=1.0
LEASE_SECONDS=60
MAX_ATTEMPTS=3

# === Media ===
# Imagens e áudio são processados pelo modelo multimodal (OpenRouter)
MEDIA_IMAGE_ENABLED=true
MEDIA_AUDIO_ENABLED=true

# === Gerenciamento de Contexto ===
# Estratégia: trim | summarize | none
CONTEXT_STRATEGY=trim

# --- TRIM ---
# Mantém os N turnos mais recentes, descarta os antigos.
# Um turno = 1 HumanMessage + todas as respostas (AI, tools, etc).
# Custo: zero (sem chamada LLM extra)
TRIM_KEEP_TURNS=5

# --- SUMMARIZE ---
# Sumariza mensagens antigas quando excede o limite de tokens.
# Custo: uma chamada LLM extra por sumarização

# Tokens antes de acionar sumarização
SUMMARIZE_TRIGGER_TOKENS=4000

# Mensagens recentes a manter após sumarização
SUMMARIZE_KEEP_MESSAGES=10

# Modelo para sumarização (use um modelo barato/rápido)
SUMMARIZE_MODEL=x-ai/grok-4.1-fast

# === Memória Semântica (LangGraph Store) ===
# Habilita recall de memórias salvas sobre o usuário
MEMORY_ENABLED=true

# Modelo de embeddings via OpenRouter (usa a mesma OPENROUTER_API_KEY)
EMBEDDING_MODEL=openai/text-embedding-3-small

# Dimensões do vetor de embedding (deve bater com o modelo)
EMBEDDING_DIMS=1536

# Máximo de memórias a buscar por consulta
MEMORY_SEARCH_LIMIT=5

# === Google Calendar (agendamento) ===
# Veja docs/GOOGLE_CALENDAR.md para o passo a passo completo de setup.
GOOGLE_CALENDAR_ENABLED=false

# Credenciais da Service Account — preencha UMA das duas opções abaixo.
# Opção A: cole o conteúdo do arquivo .json em uma linha só (Railway/Heroku)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Opção B: caminho para o arquivo .json (docker-compose local com volume)
GOOGLE_SERVICE_ACCOUNT_FILE=

# E-mail da agenda (compartilhada com o e-mail da service account)
GOOGLE_CALENDAR_ID=seuemail@gmail.com

# Fuso horário e janela de atendimento
BUSINESS_TIMEZONE=America/Sao_Paulo
BUSINESS_HOUR_START=9
BUSINESS_HOUR_END=18
APPOINTMENT_DURATION_MINUTES=30

# === Notificações proativas ===
# ID Instagram (IGSID) da médica: recebe o resumo da agenda do dia seguinte.
# Vazio desabilita o aviso. ATENÇÃO (janela de 24h do Instagram): só é
# entregue se a médica tiver enviado uma mensagem à conta nas últimas 24h.
DOCTOR_INSTAGRAM_ID=
# Hora do dia (fuso BUSINESS_TIMEZONE) em que os pacientes com consulta
# amanhã recebem o lembrete de confirmação. Também só é entregue a quem
# escreveu para a conta nas últimas 24h (fora disso é pulado e logado).
PATIENT_REMINDER_HOUR=9
# Hora do dia (fuso BUSINESS_TIMEZONE) em que a médica recebe o resumo
# fixo com a agenda do dia seguinte.
DOCTOR_SUMMARY_HOUR=20
