[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/thiagobc98/langchain_whatsapp.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
[branch "staging"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/staging
[branch "teste"]
	vscode-merge-base = origin/staging
	remote = origin
	merge = refs/heads/teste
