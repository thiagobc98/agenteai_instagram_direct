# Copie para .env.local para desenvolvimento (next dev lê .env.local).
#
# API_PROXY_TARGET: usado pelo middleware.ts para encaminhar /api,
# /webhook e /health para a API FastAPI (lido em runtime, por request).
API_PROXY_TARGET=http://localhost:8000

# NEXT_PUBLIC_API_BASE_URL: deixe vazio para usar o rewrite acima
# (mesma origem — recomendado). Só configure se a API estiver em outra
# origem e você aceitar lidar com CORS/cookies cross-site.
NEXT_PUBLIC_API_BASE_URL=
